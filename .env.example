DATABASE_URL=postgresql://elo:elo@localhost:5432/elo_padel
# Produção exige pelo menos 32 caracteres.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Chave server-only para resolver cidade a partir das coordenadas. Sem chave, buscas ranqueadas ficam indisponíveis.
GEOAPIFY_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
GRIPO_DEFAULT_URL=https://gripo.app
GRIPO_MATCH_DURATION_MINUTES=90
RESULT_SUBMISSION_WINDOW_MINUTES=60
MESSAGING_PROVIDER_URL=
MESSAGING_PROVIDER_TOKEN=
WHATSAPP_FROM=

# Google: ID do cliente OAuth usado pelo backend para validar tokens do Google.
GOOGLE_CLIENT_ID=
# Nunca habilite mock em produção; o servidor só o aceita fora de produção.
ALLOW_MOCK_AUTH=false

# Resend nativo (preferido). Ambos os valores são necessários:
RESEND_API_KEY=
EMAIL_FROM=Elo Padel <noreply@elopadel.avaliacoes.tech>

# Adaptador legado; usado apenas quando RESEND_API_KEY e EMAIL_FROM estão ausentes:
# POST EMAIL_PROVIDER_URL com Authorization: Bearer EMAIL_PROVIDER_TOKEN
# e JSON {to, subject, text, html}. Resposta 2xx é sucesso.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=

ADMIN_KEY=replace-with-an-admin-key
MAINTENANCE_TOKEN=replace-with-a-maintenance-token
